---
import "photoswipe/style.css";
import type { Photo } from "~/components/gallery/photos";

type Props = {
  photos: Photo[];
};

const { photos } = Astro.props;
---

<div class="gallery" id="photo-gallery">
  {
    photos.map((photo) => (
      <a
        href={photo.lightboxSrc}
        data-pswp-width={photo.width}
        data-pswp-height={photo.height}
        target="_blank"
        rel="noreferrer"
        style={`--aspect-ratio: ${photo.width / photo.height}`}
      >
        <img
          src={photo.src}
          srcset={photo.srcSet}
          sizes={photo.sizes}
          width={photo.width}
          height={photo.height}
          alt={photo.alt}
          loading="lazy"
          decoding="async"
        />
      </a>
    ))
  }
</div>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";

  const lightbox = new PhotoSwipeLightbox({
    gallery: "#photo-gallery",
    children: "a",
    pswpModule: () => import("photoswipe"),
  });

  lightbox.init();
</script>

<style>
  .gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .gallery::after {
    content: "";
    flex-grow: 999;
  }

  .gallery a {
    flex-basis: calc(var(--aspect-ratio) * 500px);
    flex-grow: var(--aspect-ratio);
    overflow: hidden;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 200ms ease;
  }

  .gallery a:hover img {
    transform: scale(1.015);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery img {
      transition: none;
    }
  }
</style>
